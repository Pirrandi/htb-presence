# htb-presence configuration template.
# 'htb-presence setup' writes this file for you. To edit it by hand, copy it to:
#   Linux:   ~/.config/htb-presence/config.env
#   Windows: %APPDATA%\htb-presence\config.env
#   macOS:   ~/Library/Application Support/htb-presence/config.env
# Environment variables with the same names override these values.

# Required. Hack The Box -> Profile Settings -> App Tokens.
HTB_API_TOKEN=INSERT_YOUR_API_KEY

# Presence language: en or es.
HTB_PRESENCE_LANG=en

# Seconds between HTB checks (minimum 15).
HTB_PRESENCE_INTERVAL=30

# Only change this if you created your own Discord application.
DISCORD_CLIENT_ID=1125543074861432864
